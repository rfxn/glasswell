[Unit]
Description=glasswell production-backup restore drill
Documentation=file:/opt/glasswell/src/infra/README.md
After=network-online.target postgresql.service glasswell-backup.service
Wants=network-online.target
Requires=postgresql@16-main.service
OnFailure=glasswell-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/glasswell-restore-drill.sh
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=4h
UMask=0027

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_SETGID CAP_SETUID
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/glasswell
