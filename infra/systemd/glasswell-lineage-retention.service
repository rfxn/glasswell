[Unit]
Description=Sweep expired ephemeral glasswell lineage
Documentation=file:/opt/glasswell/src/infra/README.md
After=postgresql.service
Requires=postgresql@16-main.service
OnFailure=glasswell-alert@%n.service

[Service]
Type=oneshot
User=glasswell
Group=glasswell
Environment=GLASSWELL_DSN=postgresql:///glasswell?host=/var/run/postgresql
ExecStart=/opt/glasswell/venv/bin/python -m glasswell.lineage.retention
TimeoutStartSec=300

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
