[Unit]
Description=glasswell API and map UI (uvicorn)
Documentation=file:/opt/glasswell/src/infra/README.md
After=network-online.target postgresql.service martin.service
Wants=network-online.target
Before=caddy.service
OnFailure=glasswell-alert@%n.service

[Service]
Type=exec
User=glasswell
Group=glasswell
EnvironmentFile=/etc/glasswell/db.env
EnvironmentFile=/etc/glasswell/app.env
# Loopback only: Caddy fronts this (DIR-13). --proxy-headers is what makes the request scheme
# https behind it, which is what puts upgrade-insecure-requests in the CSP.
ExecStart=/opt/glasswell/venv/bin/uvicorn glasswell.api:app --host 127.0.0.1 --port 8000 \
    --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
StateDirectory=glasswell
# The raw zone is deliberately absent: only glasswell-ingest may write /data/raw.
ReadWritePaths=/var/lib/glasswell

[Install]
WantedBy=multi-user.target
