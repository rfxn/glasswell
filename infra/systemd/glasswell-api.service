[Unit]
Description=glasswell API and map UI (uvicorn)
Documentation=file:/opt/glasswell/src/infra/README.md
After=network-online.target postgresql.service martin.service
Wants=network-online.target
Before=caddy.service
OnFailure=glasswell-alert@%n.service

[Service]
Type=exec
User=glasswell
Group=glasswell
EnvironmentFile=/etc/glasswell/db.env
EnvironmentFile=/etc/glasswell/app.env
# Deploy-stamped code identity (scripts/deploy.sh step 5c); listed last so it wins over any
# stale copy in owner-edited app.env. `-`: absent until the first deploy stamps it.
EnvironmentFile=-/etc/glasswell/code-version.env
# uvicorn binds the socket and chmods it 0666 with no knob to change that, so /run/glasswell
# at 0750 glasswell:caddy is the entire access control. The directory is NOT a
# RuntimeDirectory=: systemd re-applies exec-directory ownership on every exec invocation, so
# an ExecStartPre chgrp is undone before ExecStart runs. ../tmpfiles.d/glasswell.conf owns it
# instead, and systemd never touches it.
#
# uvicorn does not unlink a stale socket — bind() returns EADDRINUSE and it exits — so what
# RuntimeDirectory= used to guarantee by deleting the directory is now explicit.
ExecStartPre=/usr/bin/rm -f /run/glasswell/api.sock
# No TCP listener at all: Caddy dials the socket (DIR-13), and AF_UNIX has no Nagle, which is
# the ~40 ms every sub-MSS proxied response used to pay (work-output/tileperf-r2-status.md §1).
# --forwarded-allow-ips must be * here and not 127.0.0.1: a unix peer has no address, uvicorn
# leaves scope["client"] None, and a numeric allow-list would stop trusting X-Forwarded-Proto —
# silently dropping upgrade-insecure-requests from every CSP. The socket's only reachable peer
# is Caddy, so * grants nothing the directory mode has not already decided.
ExecStart=/opt/glasswell/venv/bin/uvicorn glasswell.api:app --uds /run/glasswell/api.sock \
    --workers 2 --proxy-headers --forwarded-allow-ips '*'
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
StateDirectory=glasswell
# The raw zone is deliberately absent: only glasswell-ingest may write /data/raw.
# /run/glasswell has to be listed because ProtectSystem=strict makes /run read-only and the
# socket is no longer a RuntimeDirectory= that systemd would open up on its own.
ReadWritePaths=/var/lib/glasswell /run/glasswell

[Install]
WantedBy=multi-user.target
