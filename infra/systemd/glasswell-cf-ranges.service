[Unit]
Description=Refresh the Cloudflare edge range list
Documentation=file:/opt/glasswell/src/infra/README.md
After=network-online.target
Wants=network-online.target
OnFailure=glasswell-alert@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/refresh-ranges.sh
TimeoutStartSec=120

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/glasswell
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
