[Unit]
Description=Collect the sanitized glasswell status snapshot
Documentation=file:/opt/glasswell/src/infra/README.md
After=network-online.target postgresql.service martin.service
Wants=network-online.target
OnFailure=glasswell-alert@%n.service

[Service]
Type=oneshot
User=glasswell
Group=glasswell
EnvironmentFile=/etc/glasswell/db.env
# Deploy stamps this after installing the units. It is optional only for the first activation
# on a new host; every normal deploy forces a fresh collection after stamping the file.
EnvironmentFile=-/etc/glasswell/code-version.env
ExecStart=/opt/glasswell/venv/bin/python -m glasswell.status.collector
TimeoutStartSec=120
UMask=0027

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
StateDirectory=glasswell
StateDirectoryMode=0750
ReadWritePaths=/var/lib/glasswell
