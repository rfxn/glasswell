[Unit]
Description=Cloudflare Tunnel connector for glasswell
Documentation=file:/opt/glasswell/src/infra/README.md
After=network-online.target caddy.service
Wants=network-online.target
OnFailure=glasswell-alert@%n.service

[Service]
# NOT notify: `cloudflared tunnel run` registers its connections and serves without ever
# sending sd_notify READY, so systemd holds the unit in `activating`, times the start out,
# kills a working tunnel and restarts it. Observed on 2026.8.2: four registered QUIC
# connections and /ready reporting readyConnections=4, against NRestarts=49.
Type=exec
User=cloudflared
Group=cloudflared
ExecStart=/usr/local/bin/cloudflared --config /etc/cloudflared/config.yml --no-autoupdate tunnel run
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
# The connector dials out over TCP/QUIC and reaches Caddy on loopback. AF_UNIX is not needed:
# it never touches the API socket, only 127.0.0.1:8080.
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
