# Installed as /etc/glasswell/app.env, root:root 0600. Read by glasswell-api.service and
# glasswell-ingest.service. The database DSN is NOT here: /etc/glasswell/db.env already
# carries DATABASE_URL, which the API reads as the GLASSWELL_DSN fallback.

# Static owner key. Unset fails closed — every /v1 request answers 403, never open.
# Generate with: openssl rand -hex 32   (never echo it; write it straight into the file)
GLASSWELL_OWNER_KEY=<generated>

# CSRF signing key. Generated by install.sh; never echoed. Rotating it invalidates every
# outstanding CSRF token, so the installer keeps an existing one. Unset with
# GLASSWELL_PUBLIC=1 is a startup abort, not a silently disabled check.
GLASSWELL_CSRF_KEY=<generated>

# 1 once the hostname is publicly resolvable. Turns on HSTS, refuses the static owner key
# on the tunnel listener, and makes GLASSWELL_ALLOW_ANON=1 a refusal to start.
GLASSWELL_PUBLIC=0

# Raw zone. /data is the 1 TB volume; /srv/glasswell is on the 145 GB root and is unused.
GLASSWELL_RAW_ROOT=/data/raw

# Upstream for the /v1/tiles proxy. martin listens on loopback only.
GLASSWELL_MARTIN_URL=http://127.0.0.1:3000

# Built frontend, rsynced from the build host: uvicorn mounts it at / with html=True.
GLASSWELL_WEB_ROOT=/opt/glasswell/web

# Self-hosted basemap: the PMTiles archive, its manifest and the label assets, built by
# scripts/basemap-build.sh. uvicorn mounts it keyless at /basemap and answers range
# requests with a 206, which is what PMTiles needs. Unset means no basemap is served and
# the UI falls back to OpenFreeMap, then to the graticule.
GLASSWELL_BASEMAP_ROOT=/opt/glasswell/basemap

# Pins the environment fingerprint that derive() stamps on every lineage node.
GLASSWELL_LOCKFILE_SHA256=af03ec5dc3b9f5877dbe7e2a9aeca19fde63ff911377a1a03b4f8051b21aec55

# GLASSWELL_ALLOW_ANON=1 resolves an uncredentialled caller to the viewer role — read-only,
# never owner scope. It is a development and kiosk break-glass: with GLASSWELL_PUBLIC=1 the
# API refuses to start rather than serving the internet anonymously. Off here, and any
# deployment that sets it must say so in SMOKE.md §5.
